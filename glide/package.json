{
  "name": "glide",
  "version": "0.2.3",
  "description": "GLIDE — PokeSlayerz Order Command Center: desktop order intelligence for cook groups.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "icon": "node scripts/make-icon.mjs",
    "cli": "node dist-electron/cli.cjs",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "author": "PokeSlayerz",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-virtual": "^3.14.22",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.11",
    "gifenc": "^1.0.3",
    "imapflow": "^2.9.1",
    "lucide-react": "^1.61.0",
    "mailparser": "^3.12.4",
    "motion": "^14.6.0",
    "node-html-parser": "^9.0.5",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zustand": "^5.0.16"
  },
  "productName": "GLIDE",
  "private": true,
  "build": {
    "appId": "gg.pokeslayerz.glide",
    "productName": "GLIDE",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/@resvg/**"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GLIDE-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jwetster-web",
        "repo": "Slayer-AI",
        "releaseType": "release"
      }
    ]
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwetster-web/Slayer-AI.git"
  },
  "desktopName": "GLIDE.desktop"
}
